{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/**/*.go": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://www.googletagmanager.com; connect-src 'self' https://api.github.com https://*.google-analytics.com https://*.analytics.google.com https://www.googletagmanager.com; img-src 'self' data: https://github.githubassets.com https://raw.githubusercontent.com https://avatars.githubusercontent.com https://github.com https://*.google-analytics.com https://www.googletagmanager.com; style-src 'self'; base-uri 'self'; object-src 'none'; form-action 'self' https://github.com; frame-ancestors 'none'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ],
      "source": "/(.*)"
    },
    {
      "headers": [
        {
          "key": "Vary",
          "value": "Accept"
        }
      ],
      "source": "/(.*)"
    },
    {
      "headers": [
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ],
      "source": "/auth/callback"
    },
    {
      "headers": [
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ],
      "source": "/auth/callback/(.*)"
    }
  ],
  "outputDirectory": "site",
  "rewrites": [
    {
      "destination": "/api/result",
      "source": "/result"
    },
    {
      "destination": "/api/login",
      "source": "/auth/login"
    }
  ],
  "routes": [
    {
      "dest": "/api/markdown?path=$1",
      "has": [
        {
          "key": "accept",
          "type": "header",
          "value": ".*text/markdown.*"
        }
      ],
      "src": "^/(?!api/|auth/|result(?:/|$))([^.]*)$"
    }
  ]
}
